#!/usr/bin/env ruby
#
# Usage: git rb (Remove Branch)
# Remove the current branch both locally and remotely

def get_current_branch
  `git rev-parse --abbrev-ref HEAD`.chomp
end

def get_default_branch
  `git symbolic-ref refs/remotes/origin/HEAD`.chomp.sub('refs/remotes/origin/', '')
end

def main
  current_branch = get_current_branch
  protected_branches = ['master', 'dev', 'develop', 'stable', 'master-hf', 'main']

  if protected_branches.include?(current_branch)
    $stderr.puts "Currently on protected branch, aborting."
    exit 1
  else
    default_branch = get_default_branch
    system("git checkout #{default_branch} && git push origin --delete #{current_branch} && git branch -D #{current_branch}")
  end
end

main
