.DS_Store

# Cloned by TPM into ~/.config/tmux/plugins/ (that dir is a symlink to config/tmux)
config/tmux/plugins/

# macOS /etc/zshrc falls back to $ZDOTDIR for these if HISTFILE is unset
config/zsh/.zsh_history
config/zsh/.zsh_sessions/

# Karabiner writes a dated backup here on every settings change
config/karabiner/automatic_backups/
