# Since Zsh is symlinked to ~/.config/zsh, and due to how the XDG spec structures its directories, it saves things like history and session data there — which I don't want to commit.
config/zsh/.zcompdump*
config/zsh/.zsh_history
config/zsh/.zsh_plugins.zsh

# Private work configuration
config/zsh/work

# Neovim
config/nvim/lazy-lock.json
config/nvim/package*

.DS_Store
